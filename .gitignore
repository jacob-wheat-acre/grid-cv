# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.Python
build/
dist/
*.egg-info/
*.egg
.eggs/
MANIFEST

# ── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Model weights (large binary files) ──────────────────────────────────────
models/*.pt
models/*.onnx
models/*.engine
models/*.trt
# Keep the directory itself
!models/.gitkeep

# ── Training runs ────────────────────────────────────────────────────────────
runs/
wandb/
mlruns/

# ── Datasets (raw data never belongs in source control) ──────────────────────
datasets/
raw_data/
# Keep the directory placeholder
!datasets/.gitkeep

# ── Sample & result images ──────────────────────────────────────────────────
sample_images/*.jpg
sample_images/*.jpeg
sample_images/*.png
sample_images/*.tif
sample_images/*.tiff
!sample_images/.gitkeep
results/
!results/.gitkeep

# ── IDE & OS ─────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ── Testing & coverage ───────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
.tox/
*.log

# ── Distribution / packaging ─────────────────────────────────────────────────
*.whl
*.tar.gz
pip-wheel-metadata/
.cache/

# ── Jupyter ──────────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── Environment variables / secrets ─────────────────────────────────────────
.env
.env.*
!.env.example
secrets/
credentials/
